@page "/auctions"
@using Microsoft.EntityFrameworkCore
@using NellisScanner.Core
@using NellisScanner.Core.Models
@using NellisScanner.Web.Data
@using System.Globalization
@inject NellisScannerDbContext DbContext
@inject ILogger<Auctions> Logger

<PageTitle>Nellis Scanner - Auctions</PageTitle>

<div class="container mx-auto px-4">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Auctions</h1>

    <div class="mb-6 bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <div class="flex mb-2">
                    <input type="text" @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp"
                        class="flex-1 h-10 rounded-l-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                        placeholder="Search title, auction ID, or inventory #..." />
                    <button @onclick="ApplyFilters"
                        class="h-10 bg-primary-600 text-white px-4 font-medium hover:bg-primary-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500">
                        Search
                    </button>
                    <button @onclick="ClearFilters"
                        class="h-10 bg-gray-100 text-gray-700 px-4 rounded-r-lg font-medium border border-l-0 border-gray-300 hover:bg-gray-200 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500">
                        Clear
                    </button>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" id="hideClosedAuctions" @bind="HideClosedAuctions" @bind:event="oninput"
                        @onchange="ApplyFilters"
                        class="w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500" />
                    <label for="hideClosedAuctions" class="ml-2 text-sm text-gray-700">Hide closed auctions</label>
                </div>
            </div>
            <div>
                <select @bind="SelectedCategoryId" @bind:event="oninput" @onchange="ApplyFilters"
                    class="w-full h-10 rounded-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                    <option value="">All Categories</option>
                    @foreach (var cat in Categories)
                    {
                        <option value="@((int)cat.Key)">@cat.Value</option>
                    }
                </select>
            </div>
            <div>
                <select @bind="SortBy" @bind:event="oninput" @onchange="ApplyFilters"
                    class="w-full h-10 rounded-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                    <option value="retail_desc">Retail Price (High to Low)</option>
                    <option value="retail_asc">Retail Price (Low to High)</option>
                    <option value="current_desc">Current Price (High to Low)</option>
                    <option value="current_asc">Current Price (Low to High)</option>
                    <option value="discount_desc">Biggest Discount</option>
                    <option value="closing_soon">Closing Soon</option>
                    <option value="bid_count">Most Bids</option>
                </select>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="flex justify-center items-center my-12">
            <div class="animate-spin rounded-full h-16 w-16 border-t-2 border-b-2 border-primary-500"></div>
        </div>
    }
    else if (AuctionItems == null || !AuctionItems.Any())
    {
        <div class="bg-primary-50 text-primary-700 p-4 rounded-lg">No auctions found.</div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var auction in AuctionItems)
            {
                var discountPercent = auction.DiscountPercent;

                <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden border border-gray-100">
                    <div class="flex justify-between items-center px-4 py-2 bg-gray-50 border-b border-gray-100">
                        <span
                            class="px-2 py-1 rounded-full text-xs font-semibold @(auction.State == AuctionState.Active ? "bg-emerald-100 text-emerald-700" : "bg-gray-200 text-gray-600")">
                            @auction.State
                        </span>
                        @if (!string.IsNullOrEmpty(auction.CategoryName))
                        {
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600">
                                @auction.CategoryName
                            </span>
                        }
                        <span class="px-2 py-1 rounded-full text-xs font-semibold bg-primary-50 text-primary-700">
                            ID: @auction.Id
                        </span>
                    </div>

                    <div class="p-4">
                        <h5 class="text-lg font-semibold text-gray-800 mb-2 line-clamp-2">
                            <a href="@UrlHelpers.GenerateProductUrl(auction.Id, auction.Title)" target="_blank"
                                class="text-primary-600 hover:text-primary-700 hover:underline">@auction.Title</a>
                        </h5>
                        <p class="text-xs text-gray-500 mb-3">
                            Inventory: @auction.InventoryNumber
                        </p>

                        <div class="flex items-baseline gap-2 mb-1">
                            <span class="text-2xl font-bold text-gray-900">@auction.CurrentPrice.ToString("C", CultureInfo.GetCultureInfo("en-US"))</span>
                            <span class="text-sm text-gray-400 line-through">@auction.RetailPrice.ToString("C", CultureInfo.GetCultureInfo("en-US"))</span>
                            @if (discountPercent > 0)
                            {
                                <span class="ml-auto px-2 py-0.5 rounded-full text-xs font-semibold bg-accent-500/10 text-accent-600">
                                    -@discountPercent% off
                                </span>
                            }
                        </div>

                        <div class="space-y-2 mt-3">
                            <div class="flex justify-between border-t border-gray-100 pt-2">
                                <span class="text-sm text-gray-500">Bids:</span>
                                <span class="font-medium">@auction.BidCount</span>
                            </div>
                            <div class="flex justify-between border-t border-gray-100 pt-2">
                                <span class="text-sm text-gray-500">Closes:</span>
                                <span class="font-medium">@auction.CloseTime.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="flex justify-between border-t border-gray-100 pt-2">
                                <span class="text-sm text-gray-500">Location:</span>
                                <span class="font-medium">@auction.Location</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex justify-between items-center mt-8">
            <button
                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                disabled="@(CurrentPage <= 0)" @onclick="PreviousPage">
                Previous
            </button>
            <span class="text-gray-700 text-sm">Page @(CurrentPage + 1) of @TotalPages</span>
            <button
                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                disabled="@(CurrentPage >= TotalPages - 1)" @onclick="NextPage">
                Next
            </button>
        </div>
    }
</div>

@code {
    private List<AuctionItem>? AuctionItems { get; set; }
    private bool IsLoading { get; set; } = true;
    private int CurrentPage { get; set; } = 0;
    private int PageSize { get; set; } = 12;
    private int TotalPages { get; set; } = 1;
    private string SearchTerm { get; set; } = "";
    private string SortBy { get; set; } = "retail_desc";
    private bool HideClosedAuctions { get; set; } = true;
    private string SelectedCategoryId { get; set; } = "";

    // Allow deep-linking to a pre-filtered view, e.g. /auctions?category=1&search=laptop
    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryParam { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchParam { get; set; }

    // Category lookup for the filter dropdown (id -> display name)
    private static readonly Dictionary<Category, string> Categories = new()
    {
        { Category.Electronics, "Electronics" },
        { Category.HomeAndHousehold, "Home & Household" },
        { Category.HomeImprovement, "Home Improvement" },
        { Category.SmartHome, "Smart Home" },
        { Category.OfficeAndSchool, "Office & School" },
        { Category.Automotive, "Automotive" },
    };

    protected override async Task OnInitializedAsync()
    {
        // Apply deep-link query parameters (e.g. from the Insights page)
        if (!string.IsNullOrEmpty(CategoryParam))
            SelectedCategoryId = CategoryParam;
        if (!string.IsNullOrEmpty(SearchParam))
            SearchTerm = SearchParam;

        await LoadAuctionsAsync();
    }

    private async Task LoadAuctionsAsync()
    {
        IsLoading = true;
        try
        {
            // Create a query for auctions
            IQueryable<AuctionItem> query = DbContext.Auctions.AsNoTracking();

            // Apply search filter if provided: title, auction ID, or inventory number
            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var term = SearchTerm.Trim();
                if (int.TryParse(term, out var auctionId))
                {
                    query = query.Where(a => a.Id == auctionId || a.InventoryNumber == auctionId);
                }
                else if (long.TryParse(term, out var inventoryNumber))
                {
                    query = query.Where(a => a.InventoryNumber == inventoryNumber);
                }
                else
                {
                    query = query.Where(a => a.Title != null && EF.Functions.ILike(a.Title, $"%{term}%"));
                }
            }

            // Apply category filter if selected
            if (!string.IsNullOrEmpty(SelectedCategoryId) && int.TryParse(SelectedCategoryId, out var categoryId))
            {
                query = query.Where(a => a.CategoryId == categoryId);
            }

            // Apply filter to hide closed auctions
            if (HideClosedAuctions)
            {
                query = query.Where(a => a.State == AuctionState.Active);
            }

            // Apply sorting
            query = SortBy switch
            {
                "retail_desc" => query.OrderByDescending(a => a.RetailPrice).ThenBy(a => a.Id),
                "retail_asc" => query.OrderBy(a => a.RetailPrice).ThenBy(a => a.Id),
                "current_desc" => query.OrderByDescending(a => a.CurrentPrice).ThenBy(a => a.Id),
                "current_asc" => query.OrderBy(a => a.CurrentPrice).ThenBy(a => a.Id),
                "discount_desc" => query
                    .Where(a => a.RetailPrice > 0)
                    .OrderByDescending(a => 1m - a.CurrentPrice / a.RetailPrice)
                    .ThenBy(a => a.Id),
                "closing_soon" => query.OrderBy(a => a.CloseTime).ThenBy(a => a.Id),
                "bid_count" => query.OrderByDescending(a => a.BidCount).ThenBy(a => a.Id),
                _ => query.OrderByDescending(a => a.RetailPrice).ThenBy(a => a.Id)
            };

            // Get total count for pagination
            var totalCount = await query.CountAsync();
            TotalPages = (int)Math.Ceiling(totalCount / (double)PageSize);

            // Apply pagination
            AuctionItems = await query
            .Skip(CurrentPage * PageSize)
            .Take(PageSize)
            .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading auctions");
            AuctionItems = new List<AuctionItem>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        CurrentPage = 0;
        await LoadAuctionsAsync();
    }

    private async Task ClearFilters()
    {
        SearchTerm = "";
        SortBy = "retail_desc";
        SelectedCategoryId = "";
        HideClosedAuctions = false;
        CurrentPage = 0;
        await LoadAuctionsAsync();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 0)
        {
            CurrentPage--;
            await LoadAuctionsAsync();
        }
    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages - 1)
        {
            CurrentPage++;
            await LoadAuctionsAsync();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilters();
        }
    }
}