<div class="flex flex-col h-full">
    <div class="flex items-center gap-2 px-5 h-16 border-b border-white/10">
        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-600 text-white shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
        </span>
        <a href="" class="text-lg font-semibold tracking-tight text-white">Nellis Scanner</a>
