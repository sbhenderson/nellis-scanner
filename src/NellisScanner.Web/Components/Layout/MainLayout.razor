@inherits LayoutComponentBase

<div class="flex h-screen bg-gray-100">
    <div class="w-64 bg-slate-900 text-slate-100 shrink-0">
        <NavMenu />
    </div>

    <div class="flex flex-col flex-1 overflow-hidden">
        <header class="bg-white border-b border-gray-200 shadow-xs">
            <div class="flex justify-end items-center h-14 px-6">
                <a href="/hangfire" target="_blank"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-primary-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Background Jobs
                </a>
            </div>
        </header>

        <main class="flex-1 overflow-auto p-6">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui"
    class="hidden fixed inset-x-0 bottom-0 z-50 border-t border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 shadow-[0_-4px_12px_rgba(0,0,0,0.08)]"
    data-nosnippet>
    <div class="flex items-center gap-3 max-w-5xl mx-auto">
        <span>An unhandled error has occurred.</span>
        <a href="." class="cursor-pointer px-3 py-1 rounded-md bg-amber-600 text-white text-xs font-medium hover:bg-amber-700 transition-colors">Reload</a>
        <span class="ml-auto cursor-pointer text-amber-700 hover:text-amber-900">🗙</span>
    </div>
</div>
